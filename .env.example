# =============================================================================
# ENVIRONMENT CONFIGURATION - NIGERIAN SOLAR INTELLIGENCE PLATFORM
# =============================================================================

# Database (TimescaleDB / PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/solar_intelligence
SYNC_DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/solar_intelligence

# Redis Cache & Ephemeral State
REDIS_URL=redis://localhost:6379/0

# MQTT Broker (EMQX)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=admin
MQTT_PASSWORD=public

# Meta WhatsApp Cloud API Configuration
# Get these from https://developers.facebook.com -> WhatsApp -> API Setup
WHATSAPP_TOKEN=EAAX...meta_cloud_api_token...
WHATSAPP_PHONE_NUMBER_ID=109876543210987
WHATSAPP_APP_SECRET=meta_app_secret_hex
WHATSAPP_VERIFY_TOKEN=solar_intelligence_verify_token_2026

# Energy Economics Benchmark (Nigeria)
# Fuel price for Premium Motor Spirit (PMS) in Naira per Liter
FUEL_PRICE_NGN=1150.0
